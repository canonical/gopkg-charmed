{{ entry(c) }}
{%- endfor %}
{%- endif %}
{%- if ns.upd %}
## Updates

The following major and minor features were added in this release.
{% for c in ns.upd %}
{{ entry(c) }}
{%- endfor %}
{%- endif %}
{%- if ns.fix %}
## Bug fixes

{% for c in ns.fix -%}
* {{ c.title }} ([PR]({{ c.urls.pr if c.urls.pr is string else c.urls.pr[0] }})).
{% endfor -%}
{% endif %}
