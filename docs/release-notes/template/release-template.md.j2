{#- Sections are skipped when empty; whitespace control keeps one blank line around headings for lint-md. -#}
{%- set ns = namespace(hl_feat=[], hl_brk=[], hl_fix=[], brk=[], upd=[], fix=[], dep=[], authors=[]) -%}
{%- for c in changes if is_visible(c.visibility, show_internal) -%}
{%- if c.type in ["major", "minor"] -%}
{%- set ns.upd = ns.upd + [c] -%}
{%- if c.highlight == true %}{% set ns.hl_feat = ns.hl_feat + [c] %}{% endif -%}
{%- elif c.type == "breaking" -%}
{%- set ns.brk = ns.brk + [c] -%}
{%- if c.highlight == true %}{% set ns.hl_brk = ns.hl_brk + [c] %}{% endif -%}
{%- elif c.type == "bugfix" -%}
{%- set ns.fix = ns.fix + [c] -%}
{%- if c.highlight == true %}{% set ns.hl_fix = ns.hl_fix + [c] %}{% endif -%}
{%- elif c.type == "deprecated" -%}
{%- set ns.dep = ns.dep + [c] -%}
{%- endif -%}
{%- endfor -%}
{%- for c in changes -%}
{%- set author = '[' ~ c.author ~ '](https://github.com/' ~ c.author ~ ')' -%}
{%- if author not in ns.authors %}{% set ns.authors = ns.authors + [author] %}{% endif -%}
{%- endfor -%}
{%- macro links(c) -%}
Relevant links:

{% for url in ([c.urls.pr] if c.urls.pr is string else c.urls.pr) -%}
* [PR]({{ url }})
{% endfor -%}
{% if c.urls.related_doc -%}
* [Related documentation]({{ c.urls.related_doc }})
{% endif -%}
{% if c.urls.related_issue -%}
* [Related issue]({{ c.urls.related_issue }})
{% endif -%}
{%- endmacro -%}
{%- macro entry(c) -%}
### {{ c.title }}

{{ c.description }}
<!-- Review: add context for this entry if needed. -->

{{ links(c) }}
{%- endmacro -%}
---
myst:
  html_meta:
    "description lang=en": "Release notes for {{ charm_name }} revisions {{ earliest_revision }}-{{ latest_revision }}: new features, bug fixes, and breaking changes."
---

(release_notes_release_notes_{{ release_number }})=

# {{ charm_name }} release notes – {{ release_condition }}

These release notes cover new features and changes in {{ charm_name }} for
revisions {{ earliest_revision }}-{{ latest_revision }}.
{% if summary %}
{{ summary }}
{% endif %}
{%- if ns.hl_feat %}
Main features:

{% for c in ns.hl_feat -%}
* {{ c.title }}.
{% endfor -%}
{% endif %}
{%- if ns.hl_brk %}
Main breaking changes:

{% for c in ns.hl_brk -%}
* {{ c.title }}.
{% endfor -%}
{% endif %}
{%- if ns.hl_fix %}
Main bug fixes:

{% for c in ns.hl_fix -%}
* {{ c.title }}.
{% endfor -%}
{% endif %}
See the {ref}`release policy and schedule <release_notes_index>`.

## Requirements and compatibility

<!-- Review: add upgrade instructions here if this release needs them. -->

